@startuml
skinparam monochrome false
skinparam componentStyle rectangle
skinparam backgroundColor #fdfdfd

' フロントエンド
package "フロントエンド (Vue, Nuxt3)" #LightBlue {
    [タスク入力] as taskInput <<コンポーネント>> #LightGreen
    [タスク一覧] as taskList <<コンポーネント>> #LightGreen
    [ページネーション] as pagination <<コンポーネント>> #LightGreen
    [タスク詳細モーダル] as detailsModal <<コンポーネント>> #LightGreen
    [タスク操作パネル] as taskControls <<コンポーネント>> #LightGreen
    [編集モーダル] as editModal <<コンポーネント>> #LightGreen
    [通知メッセージ] as toast <<コンポーネント>> #LightGreen

    [タスク管理] as taskManager <<コンポーネント>> #LightGreen
}

' ユーザー操作
actor ユーザー
ユーザー -> taskManager : タスクを追加、確認、編集

' フロントエンドとバックエンドの通信
taskInput --> [バックエンド (Flask)] : タスクを送信 (POST /tasks)
taskList --> [バックエンド (Flask)] : タスクを取得 (GET /tasks)

' バックエンド
package "バックエンド (Flask)" #LightYellow {
    [タスクコントローラー] as taskController <<コントローラー>> #LightPink
    [タスクサービス] as taskService <<サービス>> #LightPink
    [データベース接続] as database <<ストレージ>> #LightPink
}

taskController --> taskService : サービスを呼び出し
taskService --> database : データベースクエリ実行

' データベース
database --> [データベース (MySQL)] : タスク情報を保存

package "データベース (MySQL)" #LightGray {
    [タスクテーブル] <<テーブル>> #White
}

' フロントエンドフロー
taskInput --> taskList : タスクデータを送信
taskList --> pagination : ページネーションを処理
taskList --> detailsModal : タスク詳細を表示
detailsModal --> editModal : 編集モーダルを開く
taskList --> taskControls : タスク操作を実行
taskList --> toast : 通知メッセージを表示

' エラー処理
taskInput --> toast : エラー通知 (入力エラー)
[バックエンド (Flask)] --> toast : エラー通知 (サーバーエラー)

' 説明コメント
note right of taskInput
    ユーザーからタスクを入力します。
end note

note right of taskList
    バックエンドから取得したタスク一覧を表示します。
end note

@enduml
